{
  "name": "clash-of-pokemons",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @cop/server --filter @cop/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "models": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} -b --factory-startup --python tools/blender/build.py -- apps/client/public/models",
    "brand": "node tools/brand/render.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
